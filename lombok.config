config.stopBubbling = true

# lombok.addNullAnnotations exists, however that one is for adding new annotations to e.g. generated toString, builders, etc.
# We don't really need this, because all our code is null-marked, so added @NonNull annotations are just bloat.
# As far as I can tell, cases where @Nullable would have been added would be for e.g. generated getters or setters,
# in which case the options below already suffice.
lombok.copyableAnnotations += org.jspecify.annotations.NonNull
lombok.copyableAnnotations += org.jspecify.annotations.Nullable
